def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

# react-native-firebase's Swift Package Manager-resolved Firebase pods don't
# support static linkage (our default here, no use_frameworks!) — fall back to
# the classic CocoaPods-based Firebase SDK instead of switching linkage.
$RNFirebaseDisableSPM = true

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase's CocoaPods (GoogleUtilities etc.) need module maps to be importable
# from Swift when building as static libraries.
use_modular_headers!

setup_permissions([
  'Camera',
  'Contacts',
  'LocationWhenInUse',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'field' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react_native_post_install only fixes IPHONEOS_DEPLOYMENT_TARGET on each
    # pod's main native target; auto-generated resource-bundle sub-targets
    # (e.g. RNSVG-RNSVGFilters, AsyncStorage-AsyncStorage_resources) keep
    # their pod-declared deployment target, which can be older than the SDK's
    # minimum supported version.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < min_ios_version_supported.to_f
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
